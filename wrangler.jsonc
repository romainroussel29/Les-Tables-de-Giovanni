// Configuration Cloudflare Workers (site statique)
// Le build (npm run build) produit le dossier dist/, que Cloudflare publie tel quel.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Doit correspondre au nom du Worker dans le tableau de bord Cloudflare
  "name": "les-tables-de-giovanni",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    // Les adresses comme /menus ou /contact renvoient index.html : React Router affiche la bonne page
    "not_found_handling": "single-page-application"
  }
}
